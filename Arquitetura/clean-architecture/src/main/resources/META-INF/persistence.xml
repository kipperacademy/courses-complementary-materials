<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.2">
  <persistence-unit name="enrollment-pu" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>br.com.kipperdev.clean.interfaceadapters.gateways.persistence.EnrollmentEntity</class>
    <class>br.com.kipperdev.clean.interfaceadapters.gateways.persistence.PendingPaymentEntity</class>
    <class>br.com.kipperdev.clean.interfaceadapters.gateways.persistence.WebhookInboxEntity</class>
    <class>br.com.kipperdev.clean.interfaceadapters.gateways.persistence.ConfirmedPaymentEntity</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
      <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:file:./data/enrollments;DB_CLOSE_ON_EXIT=FALSE"/>
      <property name="hibernate.hbm2ddl.auto" value="update"/>
      <property name="hibernate.show_sql" value="false"/>
      <property name="hibernate.format_sql" value="false"/>
      <property name="hibernate.jdbc.time_zone" value="UTC"/>
    </properties>
  </persistence-unit>
</persistence>
